generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite에는 네이티브 enum이 없어 status/type은 String으로 저장하고,
// 허용값은 애플리케이션(src/lib/scheduleMeta.ts)에서 검증합니다.
//   status: "예정" | "진행" | "완료" (기본값 "예정")
//   type:   "약속" | "업무" | "개인" | "건강" | "중요" (기본값 "개인")
model Schedule {
  id        String   @id @default(cuid())
  title     String
  memo      String?
  location  String?
  startDate DateTime
  endDate   DateTime
  allDay    Boolean  @default(false)
  status    String   @default("예정")
  type      String   @default("개인")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
}
